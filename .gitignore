# training artifacts -- large, regenerable, or not ours to version
runs/
.pixi/
*.egg-info/
__pycache__/
*.pyc

# scratch/ is LLM working space and may be deleted between sessions. Keep the drivers, not the
# artifacts: an arm list is the only record of what was actually run.
scratch/**/*.npz
scratch/**/*.mp4
scratch/**/*.log
scratch/**/*.txt
scratch/**/*.png
