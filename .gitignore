# training artifacts -- large, regenerable, or not ours to version
runs/
.pixi/
*.egg-info/
__pycache__/
*.pyc

# scratch/ is LLM working space and may be deleted between sessions; dev/ is its notes and
# reports. Both are working material, not the repo's product -- what they concluded belongs in
# CLAUDE.md or docs/, which is the only place worth versioning it.
scratch/
dev/
